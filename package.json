{
  "name": "stjames-mass-planner",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "description": "St James the Apostle 6pm Mass music planner — offline HTML tool + build pipeline",
  "scripts": {
    "icons": "node scripts/generate_icons.js",
    "build": "node scripts/generate_icons.js && node scripts/build-vendor.js && node scripts/build-app.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "verify:generated": "node scripts/verify-generated.js",
    "check": "npm test && npm run verify:generated"
  },
  "engines": {
    "node": ">=22.20 <23"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "romcal": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
