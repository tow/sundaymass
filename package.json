{
  "name": "stjames-mass-planner",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "description": "St James the Apostle 6pm Mass music planner — offline HTML tool + build pipeline",
  "scripts": {
    "icons": "node scripts/generate_icons.js",
    "build": "node scripts/generate_icons.js && node scripts/build-vendor.js && node scripts/build-app.js && node scripts/build-service-worker.js",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test tests/*.test.js",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "lint": "node scripts/lint.js",
    "check:migrations": "node scripts/check-migration-rollout.js --working-tree",
    "check:edge": "deno check supabase/functions/semantic-songs/index.ts",
    "smoke:backend": "node scripts/production-backend-smoke.js",
    "smoke:browser": "node scripts/production-browser-smoke.js",
    "smoke:production": "npm run smoke:backend && npm run smoke:browser",
    "stage:pages": "node scripts/stage-pages.js",
    "verify:generated": "node scripts/verify-generated.js",
    "check": "npm run lint && npm run check:migrations && npm run check:edge && npm run test:unit && npm run test:e2e && npm run verify:generated"
  },
  "engines": {
    "node": ">=22.20 <23"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8"
  },
  "devDependencies": {
    "romcal": "1.3.0",
    "esbuild": "0.28.1",
    "deno": "2.8.1",
    "playwright-core": "1.62.0"
  }
}
